        self.header_value = header_value


class MinimalClient:
    DEFAULT_BASE_URL = "https://example.com"

    def __init__(
        self,
        base_url: Optional[str] = None,
        auth: Optional[AuthConfig] = None,
        timeout: float = 30.0,
    ):
        self._base_url = base_url or self.DEFAULT_BASE_URL
        self._auth = auth or AuthConfig()
        self._timeout = timeout
        self._requests_per_second = 1.0
        self._max_retries = 0
        self._retry_backoff = "exponential"
        self._last_request = 0.0
        self._client = httpx.AsyncClient(
            base_url=self._base_url,
            timeout=self._timeout,
            headers={
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
            },
            follow_redirects=True,
        )

    def set_auth(self, auth: AuthConfig) -> None:
        self._auth = auth

    async def close(self) -> None:
        await self._client.aclose()

    async def __aenter__(self) -> "MinimalClient":
        return self

    async def __aexit__(self, *args) -> None:
        await self.close()

    def _rate_limit(self) -> None:
        if self._requests_per_second <= 0.0:
            return
        delay = 1.0 / self._requests_per_second
        now = time.time()
        elapsed = now - self._last_request
        if elapsed < delay:
            time.sleep(delay - elapsed)
        self._last_request = time.time()

    def _backoff(self, attempt: int, retry_after: Optional[int] = None) -> float:
        base = retry_after or 1
        if self._retry_backoff == "linear":
            return base * (attempt + 1)
        if self._retry_backoff == "fixed":
            return base
        return base * (2 ** attempt)

    def _apply_auth(self, request: httpx.Request) -> httpx.Request:
        return request

    async def get(self, path: str, requires_auth: bool = False) -> str:
        if requires_auth:
            pass

        for attempt in range(self._max_retries + 1):
            self._rate_limit()
            self._client.build_request = self._wrap_build_request(self._client.build_request)
            response = await self._client.get(path)
            if response.status_code < 400:
                return response.text
            if response.status_code in (429, 500, 502, 503, 504):
                retry_after = None
                if "retry-after" in response.headers:
                    try:
                        retry_after = int(response.headers["retry-after"])
                    except ValueError:
                        retry_after = None
                if attempt < self._max_retries:
                    await asyncio.sleep(self._backoff(attempt, retry_after))
                    continue
            response.raise_for_status()
        raise RuntimeError("Max retries exceeded")

    async def fetch_home(self) -> PageTitle | None:
        html = await self.get("/", false)
        return parser.parse_home(html)


    def _wrap_build_request(self, original):
        def wrapper(method, url, **kwargs):
            request = original(method, url, **kwargs)
            return self._apply_auth(request)
        return wrapper
