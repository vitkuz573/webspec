// @generated by webspec — DO NOT EDIT

use reqwest::Client;
use std::sync::Arc;
use std::time::{Duration, Instant};
use tokio::sync::Mutex;
use crate::error::MinimalError;
use crate::models::*;
use crate::parser::Parser;

pub const DEFAULT_BASE_URL: &str = "https://example.com";

#[derive(Debug, Clone, Default)]
pub struct AuthConfig {
    pub cookie: Option<String>,
    pub header_value: Option<String>,
}

pub struct MinimalClient {
    pub client: Client,
    pub base_url: String,
    auth: Arc<Mutex<AuthConfig>>,
    requests_per_second: f64,
    max_retries: u32,
    retry_backoff: String,
    last_request: Arc<Mutex<Option<Instant>>>,
}

impl MinimalClient {
    pub fn new() -> Result<Self, MinimalError> {
        Self::with_base_url(DEFAULT_BASE_URL)
    }

    pub fn with_base_url(base_url: &str) -> Result<Self, MinimalError> {
        let client = Client::builder()
            .cookie_store(true)
            .timeout(Duration::from_secs(30))
            .build()?;
        Ok(Self {
            client,
            base_url: base_url.to_string(),
            auth: Arc::new(Mutex::new(AuthConfig::default())),
            requests_per_second: 1,
            max_retries: 0,
            retry_backoff: "exponential".to_string(),
            last_request: Arc::new(Mutex::new(None)),
        })
    }

    pub async fn set_cookie(&self, cookie: &str) {
        self.auth.lock().await.cookie = Some(cookie.to_string());
    }

    pub async fn set_header(&self, value: &str) {
        self.auth.lock().await.header_value = Some(value.to_string());
    }

    pub async fn set_bearer(&self, token: &str) {
        self.auth.lock().await.header_value = Some(format!("Bearer {}", token));
    }

    async fn apply_auth(&self, builder: reqwest::RequestBuilder, requires_auth: bool) -> reqwest::RequestBuilder {
        if !requires_auth {
            return builder;
        }
        let auth = self.auth.lock().await.clone();


        builder
    }

    async fn rate_limit(&self) {
        if self.requests_per_second <= 0.0 {
            return;
        }
        let delay = Duration::from_secs_f64(1.0 / self.requests_per_second);
        let mut last = self.last_request.lock().await;
        if let Some(instant) = *last {
            let elapsed = instant.elapsed();
            if elapsed < delay {
                tokio::time::sleep(delay - elapsed).await;
            }
        }
        *last = Some(Instant::now());
    }

    fn backoff(&self, attempt: u32, retry_after: Option<u64>) -> Duration {
        let base = retry_after.unwrap_or(1);
        match self.retry_backoff.as_str() {
            "linear" => Duration::from_secs(base * (attempt as u64 + 1)),
            "fixed" => Duration::from_secs(base),
            _ => Duration::from_secs(base * 2_u64.pow(attempt)),
        }
    }

    pub async fn get(&self, path: &str, requires_auth: bool) -> Result<String, MinimalError> {
        self.rate_limit().await;
        let url = if path.starts_with("http") {
            path.to_string()
        } else {
            format!("{}{}", self.base_url, path)
        };

        for attempt in 0..=self.max_retries {
            let builder = self.client.get(&url);
            let builder = self.apply_auth(builder, requires_auth).await;
            match builder.send().await {
                Ok(resp) if resp.status().is_success() => return Ok(resp.text().await?),
                Ok(resp) if resp.status() == 429 || resp.status().is_server_error() => {
                    let retry_after = resp.headers().get("retry-after")
                        .and_then(|v| v.to_str().ok())
                        .and_then(|v| v.parse::<u64>().ok());
                    if attempt == self.max_retries {
                        return Err(MinimalError::RateLimited(self.backoff(attempt, retry_after)));
                    }
                    tokio::time::sleep(self.backoff(attempt, retry_after)).await;
                }
                Ok(resp) => {
                    let _status = resp.status();
                    return Err(MinimalError::Http(
                        reqwest::Error::from(resp.error_for_status().unwrap_err())
                    ));
                }
                Err(e) if e.is_timeout() => {
                    if attempt == self.max_retries {
                        return Err(MinimalError::Timeout(Duration::from_secs(30)));
                    }
                    tokio::time::sleep(self.backoff(attempt, None)).await;
                }
                Err(e) => return Err(e.into()),
            }
        }

        Err(MinimalError::RateLimited(Duration::from_secs(60)))
    }

    
    pub async fn fetch_home(&self) -> Result<PageTitle, MinimalError> {
        
        let path = "/".to_string();
        
        let html = self.get(&path, false).await?;
        
        Parser::new().parse_home(&html)
            .ok_or_else(|| MinimalError::Parse(crate::error::ParseError::MissingField("PageTitle".into())))
        
    }
    
}
